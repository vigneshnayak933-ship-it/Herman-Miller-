local function IsPlayerInActiveCombat(plr, char, hum)
    if not plr or not char then return false end
    local now = os.clock()
    local myInCombat = IsLocalPlayerInCombatUI()

    local targetHasGameCombatTag = (
        char:GetAttribute("InCombat") == true or
        plr:GetAttribute("InCombat") == true or
        char:FindFirstChild("InCombat") ~= nil or
        plr:FindFirstChild("InCombat") ~= nil
    )

    if targetHasGameCombatTag then
        State.CombatTaggedPlayers[plr.UserId] = math.max(State.CombatTaggedPlayers[plr.UserId] or 0, now + 65)
        if myInCombat or State.CurrentTarget == plr or State.LockedTarget == plr then
            TagPlayerInCombatWithMe(plr, 65)
        end
        return true
    end

    if hum and hum.Health > 0 then
        local prevHp = State.PlayerLastHealth[plr.UserId]
        State.PlayerLastHealth[plr.UserId] = hum.Health
        if prevHp and hum.Health < prevHp - 1 then
            State.CombatTaggedPlayers[plr.UserId] = now + 60
            local myHrp = GetRootPart(LocalPlayer)
            local tHrp = GetRootPart(plr)
            if myHrp and tHrp and (myHrp.Position - tHrp.Position).Magnitude <= 1200 then
                TagPlayerInCombatWithMe(plr, 65)
            end
            return true
        end
    end

    if myInCombat then
        if State.CurrentTarget == plr or State.LockedTarget == plr or State.VisualLineTarget == plr then
            TagPlayerInCombatWithMe(plr, 65)
            return true
        end
        if State.InCombatWithMe[plr.UserId] and now < State.InCombatWithMe[plr.UserId] then
            State.InCombatWithMe[plr.UserId] = math.max(State.InCombatWithMe[plr.UserId], now + 15)
            State.CombatTaggedPlayers[plr.UserId] = State.InCombatWithMe[plr.UserId]
            return true
        end
    end

    local mutualExpiry = State.InCombatWithMe[plr.UserId]
    if mutualExpiry and now < mutualExpiry then
        return true
    end

    local tagExpiry = State.CombatTaggedPlayers[plr.UserId]
    if tagExpiry and now < tagExpiry then
        return true
    end

    return false
end

