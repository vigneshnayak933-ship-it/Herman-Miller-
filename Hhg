local function Collect360AuraTargets(myChar, myPos, maxRadius)
    local othersEnemies = {}
    local addedModels   = {}
    local primaryPart   = nil
    local closestDist   = maxRadius

    local function TryAddModel(model, isPlayerPlr)
        if not model or model == myChar or addedModels[model] then return end
        local hum  = model:FindFirstChildOfClass("Humanoid")
        local hrp  = model:FindFirstChild("HumanoidRootPart")
        local head = model:FindFirstChild("Head") or hrp or model:FindFirstChild("UpperTorso") or model:FindFirstChild("LowerTorso")
        local hitPart = head or hrp
        if not hum or not hitPart or hum.Health <= 0 then return end

        local dist = (hitPart.Position - myPos).Magnitude
        if dist > maxRadius then return end

        if isPlayerPlr then
            local canHit, pvpState = CanTargetPlayer(isPlayerPlr)
            if not canHit or pvpState == "Disable Pvp" then return end
            TagPlayerInCombatWithMe(isPlayerPlr, 65)
        end

        addedModels[model] = true
        table.insert(othersEnemies, { model, hitPart })

        if dist <= closestDist or not primaryPart then
            closestDist = dist
            primaryPart = hitPart
        end
    end

    local enemiesFolder = Workspace:FindFirstChild("Enemies")
    if enemiesFolder then
        for _, npc in ipairs(enemiesFolder:GetChildren()) do
            TryAddModel(npc, nil)
        end
    end

    local localSafe = IsLocalPlayerInsideSafeZone()
    for _, plr in ipairs(GetAllCandidatePlayers()) do
        local char = GetCharacter(plr)
        if char then
            local pvpState = GetPlayerPvpState(plr)
            if not localSafe or pvpState == "InCombat" then
                TryAddModel(char, plr)
            end
        end
    end

    return primaryPart, othersEnemies
end

local function ExecuteFastAttack()
    if not Config.AttackAura then return end
    if IsHoldingSkillKey() or (os.clock() - State.LastSkillFireTick < 0.45) then return end
    if not IsPlayerAlive(LocalPlayer) then return end

    local myChar = GetCharacter(LocalPlayer)
    local myHrp  = GetRootPart(LocalPlayer)
    if not myChar or not myHrp then return end

    local equippedTool = myChar:FindFirstChildOfClass("Tool")
    if not equippedTool or equippedTool.ToolTip == "Gun" then return end

    local basePart, othersEnemies = Collect360AuraTargets(myChar, myHrp.Position, 68)
    if not basePart or #othersEnemies == 0 then return end

    if not RegisterAttack or not RegisterHit then
        ResolveCombatNet()
    end

    local sessionID = GenerateCombatSessionID()

    if RegisterAttack then
        pcall(function()
            RegisterAttack:FireServer(0)
        end)
    end

    pcall(function()
        local renv = getrenv and getrenv() or _G
        local sendFn = (renv and renv._G and renv._G.SendHitsToServer) or _G.SendHitsToServer
        if type(sendFn) == "function" then
            sendFn(basePart, othersEnemies)
        end
    end)

    if RegisterHit then
        pcall(function()
            if sessionID then
                RegisterHit:FireServer(basePart, othersEnemies, nil, sessionID)
            else
                RegisterHit:FireServer(basePart, othersEnemies)
            end
        end)
    end

    if NetHitAuth.Captured and NetHitAuth.Remote and NetHitAuth.Remote.Parent then
        local meshOrHead = basePart.Parent and (basePart.Parent:FindFirstChildWhichIsA("MeshPart") or basePart) or basePart
        local obfArgs = {
            NetHitAuth.HitToken,
            NetHitAuth.SessionId,
            meshOrHead,
            othersEnemies,
            [6] = NetHitAuth.SessionHex
        }
        pcall(function()
            NetHitAuth.Remote:FireServer(unpack(obfArgs, 1, 6))
        end)
    end

    local leftClickRemote = equippedTool:FindFirstChild("LeftClickRemote")
    if leftClickRemote then
        local diff = basePart.Position - myHrp.Position
        local dir = (diff.Magnitude > 0.001) and diff.Unit or myHrp.CFrame.LookVector
        State.ComboCounter = (State.ComboCounter % 4) + 1
        pcall(function()
            leftClickRemote:FireServer(dir, State.ComboCounter, true)
        end)
    end

    local ac = GetCombatActiveController()
    if ac then
        pcall(function()
            ac.timeToNextAttack = 0
            ac.attacking = false
            ac.blocking = false
            ac.increment = 3
            ac.hitboxMagnitude = 68
        end)
    end
end

