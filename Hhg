local function FormatCompactNumber(n)
    n = tonumber(n) or 0
    if n >= 1e9 then
        return string.format("%.2fB", n / 1e9)
    elseif n >= 1e6 then
        return string.format("%.2fM", n / 1e6)
    elseif n >= 1e3 then
        return string.format("%.1fK", n / 1e3)
    end
    return tostring(math.floor(n))
end

local function TryPortalBypass(targetPos)
    if not Config.BypassTP or not CommF_ then return false end
    local myHrp = GetRootPart(LocalPlayer)
    if not myHrp then return false end
    local activePortalMap = IsSea3 and PortalLocations.Sea3 or (IsSea2 and PortalLocations.Sea2 or (IsSea1 and PortalLocations.Sea1 or nil))
    if not activePortalMap then return false end

    local currentDist = (myHrp.Position - targetPos).Magnitude
    local bestPortalVec = nil
    local shortestDist = currentDist

    for _, portalVec in pairs(activePortalMap) do
        local distFromPortal = (portalVec - targetPos).Magnitude
        if (distFromPortal + 300) < shortestDist then
            shortestDist = distFromPortal
            bestPortalVec = portalVec
        end
    end

    if bestPortalVec then
        pcall(function()
            CommF_:InvokeServer("requestEntrance", bestPortalVec)
        end)
        return true
    end
    return false
end

-- Syncs SilentCache immediately against current activeTarget so skill casts always have fresh 3D coordinates
local function RefreshSilentCacheInstant()
    local myHrp = GetRootPart(LocalPlayer)
    local activeTarget = State.LockedTarget or State.CurrentTarget
    local cam = Workspace.CurrentCamera or Camera
    if Config.SilentAim and activeTarget and IsPlayerAlive(activeTarget) and myHrp then
        local tChar = GetCharacter(activeTarget)
        local aimPart = (tChar and tChar:FindFirstChild(Config.AimPart)) or GetRootPart(activeTarget)
        if aimPart and aimPart:IsA("BasePart") then
            local vel = aimPart.AssemblyLinearVelocity or Vector3.zero
            local clampedVel = Vector3.new(vel.X, math.clamp(vel.Y, -28, 28), vel.Z)
            local predPos = aimPart.Position + (clampedVel * Config.PredictionFactor)
            local origPos = myHrp.Position
            local diff = predPos - origPos
            local uDir = (diff.Magnitude > 0.001) and diff.Unit or Vector3.new(0, 0, -1)

            SilentCache.Active    = true
            SilentCache.TargetPos = predPos
            SilentCache.OriginPos = origPos
            SilentCache.UnitDir   = uDir
            SilentCache.HitCFrame = CFrame.lookAt(predPos, predPos + uDir)
            SilentCache.AimPart   = aimPart
            SilentCache.CameraPos = cam and cam.CFrame.Position or origPos
            return true
        end
    end
    return SilentCache.Active
end

-- Video 2 Hermanos-Accurate Skill Gyro, Character 3D CFrame & MousePos Lock
local GuardedGyros = setmetatable({}, { __mode = "k" })

local function GuardGyroInstance(gyroObj)
    if not gyroObj or GuardedGyros[gyroObj] then return end
    GuardedGyros[gyroObj] = true
    gyroObj:GetPropertyChangedSignal("CFrame"):Connect(function()
        if Config.SilentAim and SilentCache.Active then
            local myHrp = GetRootPart(LocalPlayer)
            local tPos  = SilentCache.TargetPos
            if myHrp and (tPos - myHrp.Position).Magnitude > 0.1 then
                local desiredCF = CFrame.lookAt(myHrp.Position, tPos)
                if (gyroObj.CFrame.LookVector - desiredCF.LookVector).Magnitude > 0.01 then
                    gyroObj.CFrame = desiredCF
                end
            end
        end
    end)
end

local function AlignSkillGyroToTarget(forceCharacterSnap)
    if not Config.SilentAim then return end
    if not SilentCache.Active then
        RefreshSilentCacheInstant()
    end
    if not SilentCache.Active then return end

    local myHrp = GetRootPart(LocalPlayer)
    if not myHrp then return end
    local tPos = SilentCache.TargetPos
    local diff = tPos - myHrp.Position
    if diff.Magnitude <= 0.1 then return end

    local look3D = CFrame.lookAt(myHrp.Position, tPos)

    -- 1. Lock every BodyGyro & AlignOrientation inside HumanoidRootPart
    for _, child in ipairs(myHrp:GetChildren()) do
        if child:IsA("BodyGyro") or child:IsA("AlignOrientation") then
            GuardGyroInstance(child)
            child.CFrame = look3D
        end
    end

    -- 2. Snap character HumanoidRootPart toward target during skill cast (matches Video 2 Skull Guitar / Tiger / CDK / Godhuman!)
    local hasActiveSkillMover = (
        myHrp:FindFirstChildOfClass("BodyGyro") ~= nil or
        myHrp:FindFirstChildOfClass("AlignOrientation") ~= nil
    )
    if forceCharacterSnap or hasActiveSkillMover or IsHoldingSkillKey() or (os.clock() < State.SkillAimEndTick) then
        local flatDist = Vector2.new(diff.X, diff.Z).Magnitude
        local hum = GetHumanoid(LocalPlayer)
        local isAirborne = hum and (
            hum.FloorMaterial == Enum.Material.Air or
            hum:GetState() == Enum.HumanoidStateType.Freefall or
            hum:GetState() == Enum.HumanoidStateType.Jumping
        )
        if isAirborne or hasActiveSkillMover or math.abs(diff.Y) > 8 then
            myHrp.CFrame = look3D
        elseif flatDist > 0.1 then
            myHrp.CFrame = CFrame.lookAt(myHrp.Position, Vector3.new(tPos.X, myHrp.Position.Y, tPos.Z))
        end
    end
end

local function TriggerSkillAimWindow(duration)
    local now = os.clock()
    State.LastSkillFireTick = now
    State.SkillAimEndTick   = math.max(State.SkillAimEndTick or 0, now + (duration or 0.75))
    if Config.SilentAim then
        RefreshSilentCacheInstant()
        AlignSkillGyroToTarget(true)
        if CommE and SilentCache.Active then
            local targetPos = SilentCache.TargetPos
            task.spawn(function()
                pcall(function()
                    CommE:FireServer("MousePos", targetPos)
                end)
            end)
        end
    end
end

local function SendKeyPress(keyCode, holdDuration)
    holdDuration = tonumber(holdDuration) or 0.05
    TriggerSkillAimWindow(holdDuration + 0.65)
    task.spawn(function()
        if VirtualInputManager then
            VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
            if holdDuration > 0 then
                task.wait(holdDuration)
            end
            if Config.SilentAim then
                AlignSkillGyroToTarget(true)
            end
            VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
        end
    end)
end

local function IsPositionInSafeZone(pos)
    local worldOrigin = Workspace:FindFirstChild("_WorldOrigin")
    local safeZones = (worldOrigin and worldOrigin:FindFirstChild("SafeZones")) or Workspace:FindFirstChild("SafeZones")

    if safeZones then
        local foundZoneParts = false
        for _, zone in ipairs(safeZones:GetDescendants()) do
            if zone:IsA("BasePart") then
                foundZoneParts = true
                local sx, sy, sz = zone.Size.X, zone.Size.Y, zone.Size.Z
                local mesh = zone:FindFirstChildOfClass("DataModelMesh")
                if mesh and sx <= 4 and sz <= 4 then
                    sx = mesh.Scale.X
                    sy = mesh.Scale.Y
                    sz = mesh.Scale.Z
                end
                local rel = zone.CFrame:PointToObjectSpace(pos)
                local halfX = (sx * 0.5)
                local halfZ = (sz * 0.5)
                local halfY = math.max(sy * 0.5, 160)
                if math.abs(rel.X) <= halfX and math.abs(rel.Z) <= halfZ and math.abs(rel.Y) <= halfY then
                    return true
                end
            end
        end
        if foundZoneParts then
            return false
        end
    end

    for _, sz in ipairs(FallbackSafeZones) do
        local flatDist = Vector2.new(pos.X - sz.Pos.X, pos.Z - sz.Pos.Z).Magnitude
        if flatDist <= sz.Radius and math.abs(pos.Y - sz.Pos.Y) <= 180 then
            return true
        end
    end

    return false
end

