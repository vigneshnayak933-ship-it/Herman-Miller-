        valLbl.TextSize = 11
        valLbl.TextXAlignment = Enum.TextXAlignment.Right
        valLbl.ZIndex = 14
        valLbl.Parent = card

        local track = Instance.new("Frame")
        track.AnchorPoint = Vector2.new(1, 0.5)
        track.Position = UDim2.new(1, -14, 0.5, 0)
        track.Size = UDim2.fromOffset(86, 4)
        track.BackgroundColor3 = Theme.SliderTrack
        track.ZIndex = 14
        track.Parent = card

        local trackCorner = Instance.new("UICorner")
        trackCorner.CornerRadius = UDim.new(1, 0)
        trackCorner.Parent = track

        local initAlpha = math.clamp((defaultVal - minVal) / (maxVal - minVal), 0, 1)
        local fill = Instance.new("Frame")
        fill.Size = UDim2.new(initAlpha, 0, 1, 0)
        fill.BackgroundColor3 = Theme.SliderFill
        fill.ZIndex = 15
        fill.Parent = track

        local fillCorner = Instance.new("UICorner")
        fillCorner.CornerRadius = UDim.new(1, 0)
        fillCorner.Parent = fill

        local thumb = Instance.new("Frame")
        thumb.AnchorPoint = Vector2.new(0.5, 0.5)
        thumb.Position = UDim2.new(initAlpha, 0, 0.5, 0)
        thumb.Size = UDim2.fromOffset(13, 13)
        thumb.BackgroundColor3 = Theme.SliderThumb
        thumb.ZIndex = 16
        thumb.Parent = track

        local thumbCorner = Instance.new("UICorner")
        thumbCorner.CornerRadius = UDim.new(1, 0)
        thumbCorner.Parent = thumb

        local sDragging = false
        local function UpdateFromInput(inputPos)
            local relX = math.clamp((inputPos.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            local computed = math.floor(minVal + (maxVal - minVal) * relX + 0.5)
            local snappedAlpha = (computed - minVal) / (maxVal - minVal)
            fill.Size = UDim2.new(snappedAlpha, 0, 1, 0)
            thumb.Position = UDim2.new(snappedAlpha, 0, 0.5, 0)
            valLbl.Text = tostring(computed)
            if callback then
                task.spawn(callback, computed)
            end
        end

        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                sDragging = true
                UpdateFromInput(input.Position)
            end
        end)
        thumb.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                sDragging = true
                UpdateFromInput(input.Position)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if sDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                UpdateFromInput(input.Position)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                sDragging = false
            end
        end)

        table.insert(AllSearchableCards, {
            Card  = card,
            Query = string.lower(titleText .. " " .. subtitleText)
        })
    end

