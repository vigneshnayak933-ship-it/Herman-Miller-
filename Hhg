local WindowAnimId      = 0
local ActiveScaleTween  = nil
local ActiveBgTween     = nil
local ActiveStrokeTween = nil

local function SetMainWindowOpen(shouldOpen)
    WindowAnimId += 1
    local currentAnimId = WindowAnimId
    Config.UI_Visible = shouldOpen

    if ActiveScaleTween then pcall(function() ActiveScaleTween:Cancel() end) end
    if ActiveBgTween then pcall(function() ActiveBgTween:Cancel() end) end
    if ActiveStrokeTween then pcall(function() ActiveStrokeTween:Cancel() end) end

    TweenService:Create(FloatingToggleScale, TweenInfo.new(0.09, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 0.88 }):Play()
    TweenService:Create(TopBannerScale, TweenInfo.new(0.09, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 0.94 }):Play()
    task.delay(0.09, function()
        TweenService:Create(FloatingToggleScale, TweenInfo.new(0.20, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
        TweenService:Create(TopBannerScale, TweenInfo.new(0.20, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
    end)

    if shouldOpen then
        if not MainWindow.Visible then
            MainWindowScale.Scale = 0.80
            MainWindow.BackgroundTransparency = 0.85
            MainWindowStroke.Transparency = 0.90
            MainWindow.Visible = true
        end
        ActiveScaleTween = TweenService:Create(
            MainWindowScale,
            TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
            { Scale = 1.0 }
        )
        ActiveBgTween = TweenService:Create(
            MainWindow,
            TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
            { BackgroundTransparency = Theme.WindowTrans }
        )
        ActiveStrokeTween = TweenService:Create(
            MainWindowStroke,
            TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
            { Transparency = 0.25 }
        )
        ActiveScaleTween:Play()
        ActiveBgTween:Play()
        ActiveStrokeTween:Play()
    else
        ActiveScaleTween = TweenService:Create(
            MainWindowScale,
            TweenInfo.new(0.20, Enum.EasingStyle.Back, Enum.EasingDirection.In),
            { Scale = 0.80 }
        )
        ActiveBgTween = TweenService:Create(
            MainWindow,
            TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
            { BackgroundTransparency = 0.92 }
        )
        ActiveStrokeTween = TweenService:Create(
            MainWindowStroke,
            TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
            { Transparency = 1.0 }
        )
        ActiveScaleTween:Play()
        ActiveBgTween:Play()
        ActiveStrokeTween:Play()

        task.delay(0.20, function()
            if WindowAnimId == currentAnimId and not Config.UI_Visible then
                MainWindow.Visible = false
            end
        end)
    end
end

local function ToggleMainWindowVisibility()
    SetMainWindowOpen(not Config.UI_Visible)
end

local function BindDraggableGuiToggle(guiButton)
    local dragging, dragStart, startPos, moved = false, nil, nil, false
    guiButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            dragStart = input.Position
            startPos = guiButton.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            if delta.Magnitude > 6 then
                moved = true
                guiButton.Position = UDim2.new(
                    startPos.X.Scale,
                    startPos.X.Offset + delta.X,
                    startPos.Y.Scale,
                    startPos.Y.Offset + delta.Y
                )
            end
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragging and not moved then
                ToggleMainWindowVisibility()
            end
            dragging = false
        end
    end)
end

