local AllSearchableCards = {}

local function SelectTab(tabName)
    for name, tabData in pairs(TabsRegistry) do
        local isSelected = (name == tabName)
        tabData.Page.Visible = isSelected
        TweenService:Create(tabData.Button, TweenInfo.new(0.15), {
            BackgroundTransparency = isSelected and Theme.TabActiveTrans or 1
        }):Play()
        tabData.TitleLabel.TextColor3 = isSelected and Theme.TextPrimary or Theme.TextSecondary
        tabData.IconLabel.ImageColor3 = isSelected and Theme.TextPrimary or Theme.TextSecondary
    end
end

