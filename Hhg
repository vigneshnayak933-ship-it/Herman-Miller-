local function ExecuteSkillComboStep()
    if IsHoldingSkillKey() then return end

    local rotationOrder = {}
    if Config.UseMelee then table.insert(rotationOrder, "Melee") end
    if Config.UseSword then table.insert(rotationOrder, "Sword") end
    if Config.UseFruit then table.insert(rotationOrder, "Blox Fruit") end
    if Config.UseGun   then table.insert(rotationOrder, "Gun") end
    if #rotationOrder == 0 then return end

    State.WeaponCycleIndex = (State.WeaponCycleIndex % #rotationOrder) + 1
    local chosenType = rotationOrder[State.WeaponCycleIndex]
    EquipWeaponByType(chosenType)

    if chosenType == "Melee" then
        if Config.Melee_Z then SendKeyPress(Enum.KeyCode.Z, Config.MeleeHoldZ) end
        if Config.Melee_X then SendKeyPress(Enum.KeyCode.X, Config.MeleeHoldX) end
        if Config.Melee_C then SendKeyPress(Enum.KeyCode.C, Config.MeleeHoldC) end
    elseif chosenType == "Sword" then
        if Config.Sword_Z then SendKeyPress(Enum.KeyCode.Z, Config.SwordHoldZ) end
        if Config.Sword_X then SendKeyPress(Enum.KeyCode.X, Config.SwordHoldX) end
    elseif chosenType == "Blox Fruit" then
        if Config.Fruit_Z then SendKeyPress(Enum.KeyCode.Z, Config.FruitHoldZ) end
        if Config.Fruit_X then SendKeyPress(Enum.KeyCode.X, Config.FruitHoldX) end
        if Config.Fruit_C then SendKeyPress(Enum.KeyCode.C, Config.FruitHoldC) end
        if Config.Fruit_V then SendKeyPress(Enum.KeyCode.V, Config.FruitHoldV) end
    elseif chosenType == "Gun" then
        if Config.Gun_Z then SendKeyPress(Enum.KeyCode.Z, Config.GunHoldZ) end
        if Config.Gun_X then SendKeyPress(Enum.KeyCode.X, Config.GunHoldX) end
    end
end

