-- Fixes the ground-tap CFrame bug so every skill (Tiger Z/X/C, Skull Guitar Z/X, CDK Z/X, Godhuman Z/X/C)
-- lands directly on the target's 3D position and along the red line!
local function RewriteAimArg(val)
    local tPos  = SilentCache.TargetPos
    local oPos  = SilentCache.OriginPos
    local uDir  = SilentCache.UnitDir
    local hitCF = SilentCache.HitCFrame

    if typeof(val) == "Vector3" then
        local mag = val.Magnitude
        if mag >= 0.95 and mag <= 1.05 then
            return uDir
        elseif mag > 4 then
            return tPos
        end
        return val
    elseif typeof(val) == "CFrame" then
        local p = val.Position
        -- Only keep origin position if the CFrame is literally HumanoidRootPart.CFrame itself (<= 3.2 studs)
        -- Every Mouse.Hit / screen-tap CFrame (even on nearby ground) gets moved to SilentCache.HitCFrame!
        if (p - oPos).Magnitude <= 3.2 and (tPos - p).Magnitude > 0.1 then
            return CFrame.lookAt(p, tPos)
        else
            return hitCF
        end
    elseif typeof(val) == "Ray" then
        return Ray.new(oPos, uDir * math.max(val.Direction.Magnitude, 1000))
    end
    return val
end

local function ProcessSkillRemoteArgs(self, method, ...)
    local rName = self.Name
    local parent = self.Parent
    local isToolRemote = (parent and parent:IsA("Tool")) or (parent and parent.Parent and parent.Parent:IsA("Tool"))

    if rName == "CommE" then
        local args = { ... }
        local nArgs = select("#", ...)
        if args[1] == "MousePos" then
            if typeof(args[2]) == "CFrame" then
                args[2] = SilentCache.HitCFrame
            else
                args[2] = SilentCache.TargetPos
            end
            return true, args, nArgs
        end
    elseif rName == "LeftClickRemote" then
        State.LastSkillFireTick = os.clock()
        State.SkillAimEndTick   = math.max(State.SkillAimEndTick or 0, os.clock() + 0.45)
        local activeTarget = State.LockedTarget or State.CurrentTarget
        if activeTarget then
            TagPlayerInCombatWithMe(activeTarget, 65)
        end
        local args = { ... }
        local nArgs = select("#", ...)
        if typeof(args[1]) == "Vector3" then
            args[1] = SilentCache.UnitDir
        elseif typeof(args[1]) == "CFrame" then
            args[1] = SilentCache.HitCFrame
        end
        return true, args, nArgs
    elseif rName == "ShootGunEvent" then
        State.LastSkillFireTick = os.clock()
        State.SkillAimEndTick   = math.max(State.SkillAimEndTick or 0, os.clock() + 0.65)
        local activeTarget = State.LockedTarget or State.CurrentTarget
        if activeTarget then
            TagPlayerInCombatWithMe(activeTarget, 65)
        end
        local args = { ... }
        local nArgs = select("#", ...)
        if typeof(args[1]) == "Vector3" then
            args[1] = SilentCache.TargetPos
        elseif typeof(args[1]) == "CFrame" then
            args[1] = SilentCache.HitCFrame
        end
        return true, args, nArgs
    elseif isToolRemote or rName == "RemoteEvent" or rName == "RemoteFunction" then
        State.LastSkillFireTick = os.clock()
        State.SkillAimEndTick   = math.max(State.SkillAimEndTick or 0, os.clock() + 0.85)
        local activeTarget = State.LockedTarget or State.CurrentTarget
        if activeTarget then
            TagPlayerInCombatWithMe(activeTarget, 65)
        end
        local args = { ... }
        local nArgs = select("#", ...)
        for i = 1, nArgs do
            args[i] = RewriteAimArg(args[i])
        end
        return true, args, nArgs
    end

    return false, nil, 0
end

local HookingEstablished = false
if hookmetamethod then
    pcall(function()
        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            if not checkcaller() then
                local method = getnamecallmethod()

                if method == "FireServer" or method == "InvokeServer" then
                    local a1, a2, a3, a4, a5, a6 = ...
                    if type(a1) == "string" and type(a2) == "number" and type(a4) == "table" and (type(a6) == "string" or type(a5) == "string") then
                        NetHitAuth.Remote     = self
                        NetHitAuth.HitToken   = a1
                        NetHitAuth.SessionId  = a2
                        NetHitAuth.SessionHex = type(a6) == "string" and a6 or a5
                        NetHitAuth.Captured   = true
                    end

                    if Config.SilentAim and SilentCache.Active then
                        local modified, newArgs, nArgs = ProcessSkillRemoteArgs(self, method, ...)
                        if modified and newArgs then
                            if setnamecallmethod then
                                setnamecallmethod(method)
                            end
                            return oldNamecall(self, unpack(newArgs, 1, nArgs))
                        end
                    end

                elseif Config.SilentAim and SilentCache.Active then
                    -- Mobile & PC Viewport/Screen Ray Redirection (used by Blox Fruits mobile "Use" buttons!)
                    if self == Camera and (method == "ViewportPointToRay" or method == "ScreenPointToRay") then
                        local camPos = SilentCache.CameraPos
                        local dir = (SilentCache.TargetPos - camPos)
                        local uDir = (dir.Magnitude > 0.001) and dir.Unit or SilentCache.UnitDir
                        return Ray.new(camPos, uDir)

                    elseif self == Workspace then
                        if method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRay" or method == "FindPartOnRayWithWhitelist" then
                            local rayArg = select(1, ...)
                            if typeof(rayArg) == "Ray" then
                                local d = rayArg.Direction
                                -- Ignore short vertical ground/water check rays pointing straight down
                                if d.Magnitude > 35 and d.Unit.Y > -0.94 then
                                    local args = { ... }
                                    local nArgs = select("#", ...)
                                    local origin = rayArg.Origin
                                    local toTarget = (SilentCache.TargetPos - origin)
                                    if toTarget.Magnitude > 0.05 then
                                        args[1] = Ray.new(origin, toTarget.Unit * math.max(d.Magnitude, 1000))
                                        if setnamecallmethod then
                                            setnamecallmethod(method)
                                        end
                                        return oldNamecall(self, unpack(args, 1, nArgs))
                                    end
                                end
                            end
                        elseif method == "Raycast" then
                            local origArg, dirArg = select(1, ...)
                            if typeof(origArg) == "Vector3" and typeof(dirArg) == "Vector3" then
                                if dirArg.Magnitude > 35 and dirArg.Unit.Y > -0.94 then
                                    local args = { ... }
                                    local nArgs = select("#", ...)
                                    local toTarget = (SilentCache.TargetPos - origArg)
                                    if toTarget.Magnitude > 0.05 then
                                        args[2] = toTarget.Unit * math.max(dirArg.Magnitude, 1000)
                                        if setnamecallmethod then
                                            setnamecallmethod(method)
                                        end
                                        return oldNamecall(self, unpack(args, 1, nArgs))
                                    end
                                end
                            end
                        end
                    end
                end
            end
            return oldNamecall(self, ...)
        end))
        HookingEstablished = true
    end)

    pcall(function()
        local oldIndex
        oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
            if Config.SilentAim and SilentCache.Active and self == Mouse and not checkcaller() then
                if key == "Hit" or key == "hit" then
                    return SilentCache.HitCFrame
                elseif key == "Target" or key == "target" then
                    return SilentCache.AimPart
                elseif key == "UnitRay" or key == "unitRay" then
                    local camPos = SilentCache.CameraPos
                    local diff = SilentCache.TargetPos - camPos
                    local uDir = (diff.Magnitude > 0.001) and diff.Unit or SilentCache.UnitDir
                    return Ray.new(camPos, uDir)
                elseif key == "Origin" or key == "origin" then
                    return CFrame.lookAt(SilentCache.CameraPos, SilentCache.TargetPos)
                end
            end
            return oldIndex(self, key)
        end))
    end)
end

