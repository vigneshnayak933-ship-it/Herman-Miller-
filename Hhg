        local flatMove = Vector3.new(hum.MoveDirection.X, 0, hum.MoveDirection.Z)
        if flatMove.Magnitude > 0.001 then
            local moveDir = flatMove.Unit
            local mult = math.clamp(Config.SpeedMultiply, 1, 50)
            local stepStuds = (mult * 0.30) * math.min(dt * 60, 2.5)
            hrp.CFrame = hrp.CFrame + (moveDir * stepStuds)

            if os.clock() - State.LastPhaseTick > 0.12 then
                WallPhaseParams.FilterDescendantsInstances = { char, WorldVisualsFolder }
                local hitForward = Workspace:Raycast(hrp.Position, moveDir * 2.6, WallPhaseParams)
                if hitForward and hitForward.Instance and hitForward.Instance.CanCollide then
                    local testPos = hrp.Position + (moveDir * 6.5)
                    local hitInside = Workspace:Raycast(testPos, -moveDir * 5.5, WallPhaseParams)
                    if hitInside and hitInside.Instance == hitForward.Instance then
                        local thickness = (hitInside.Position - hitForward.Position).Magnitude
                        if thickness <= 8.5 then
                            State.LastPhaseTick = os.clock()
                            hrp.CFrame = hrp.CFrame + (moveDir * (thickness + 2.2))
                        end
                    end
                end
            end
        end
    end

    if Config.WalkOnWater then
        local map = Workspace:FindFirstChild("Map")
        local waterPlane = map and map:FindFirstChild("WaterBase-Plane")
        if waterPlane and waterPlane.Size.Y < 110 then
            waterPlane.Size = Vector3.new(1000, 112, 1000)
        end
    end

    if Config.InfiniteEnergy then
        local energyObj = char:FindFirstChild("Energy")
        if energyObj and energyObj:IsA("ValueBase") then
            energyObj.Value = energyObj.MaxValue or 15000
        end
    end

    if Config.InvisiblePlus then
        local rootJoint = hrp:FindFirstChild("RootJoint")
        if rootJoint and rootJoint:IsA("Motor6D") then
            rootJoint.C0 = CFrame.new(0, 0, 0) * CFrame.Angles(math.rad(-90), 0, math.rad(180))
        end
    end

    local activeTarget = State.LockedTarget or State.CurrentTarget
    if Config.TeleportBehideTarget and activeTarget and IsPlayerAlive(activeTarget) then
        local tHrp = GetRootPart(activeTarget)
        if tHrp then
            local dist = (hrp.Position - tHrp.Position).Magnitude
            if dist <= Config.TeleportBehideRange then
                TagPlayerInCombatWithMe(activeTarget, 65)
                hrp.CFrame = tHrp.CFrame * CFrame.new(0, Config.TeleportOffsetY, Config.TeleportOffsetZ)
            end
        end
    end
end))

-- 3. Heartbeat: Auto Haki, Race V3/V4, 360° Background Attack Aura, Auto Skills & ESP Updates
table.insert(State.Connections, RunService.Heartbeat:Connect(function()
    local now   = os.clock()
    local char  = GetCharacter(LocalPlayer)
    local hum   = GetHumanoid(LocalPlayer)
    local myHrp = GetRootPart(LocalPlayer)
    local activeTarget = State.LockedTarget or State.CurrentTarget

    if hum and hum.Health > 0 then
        if State.MyLastHealth and hum.Health < State.MyLastHealth - 1 and myHrp then
            if activeTarget then
                TagPlayerInCombatWithMe(activeTarget, 65)
            else
                for _, plr in ipairs(GetAllCandidatePlayers()) do
                    if IsPlayerAlive(plr) then
                        local tHrp = GetRootPart(plr)
                        if tHrp and (myHrp.Position - tHrp.Position).Magnitude <= 350 then
                            TagPlayerInCombatWithMe(plr, 65)
                        end
                    end
                end
            end
        end
        State.MyLastHealth = hum.Health
    end

    if Config.BusoHaki and char and not char:FindFirstChild("HasBuso") and (now - State.LastBusoTick > 1.5) then
        State.LastBusoTick = now
        if CommF_ then
            task.spawn(function()
                pcall(function() CommF_:InvokeServer("Buso") end)
            end)
        end
    end

    if Config.KenHaki and char and (now - State.LastKenTick > 2.5) then
        State.LastKenTick = now
        if CommE then
            task.spawn(function()
                pcall(function() CommE:FireServer("Ken", true) end)
            end)
        end
    end

    if Config.RaceV3 and char and (now - State.LastRaceV3Tick > 1.2) then
        State.LastRaceV3Tick = now
        if CommE then
            task.spawn(function()
                pcall(function() CommE:FireServer("ActivateAbility") end)
            end)
        end
    end

    if Config.RaceV4 and char and (now - State.LastRaceV4Tick > 1.5) then
        State.LastRaceV4Tick = now
        local awakeningTool = char:FindFirstChild("Awakening") or (LocalPlayer:FindFirstChild("Backpack") and LocalPlayer.Backpack:FindFirstChild("Awakening"))
        if awakeningTool and awakeningTool:FindFirstChild("RemoteFunction") then
            task.spawn(function()
                pcall(function() awakeningTool.RemoteFunction:InvokeServer(true) end)
            end)
        end
    end

    if (Config.InfiniteGeppo or Config.SoruSilent) and (now - State.LastGCPatchTick > 1.2) then
        State.LastGCPatchTick = now
        PatchSoruAndGeppoGC()
    end

    if Config.AttackAura and (now - State.LastAttackTick >= Config.FastAttackDelay) then
        State.LastAttackTick = now
        ExecuteFastAttack()
    end

    if Config.AutoSkills and activeTarget and IsPlayerAlive(activeTarget) and (now - State.LastSkillTick > 0.65) then
        local tHrp = GetRootPart(activeTarget)
        if myHrp and tHrp and (myHrp.Position - tHrp.Position).Magnitude <= 55 then
            State.LastSkillTick = now
            TagPlayerInCombatWithMe(activeTarget, 65)
            ExecuteSkillComboStep()
        end
    end

    UpdateESP()
end))

-- 4. Keyboard InputBegan & InputEnded Handlers
local SkillKeyMap = {
    [Enum.KeyCode.Z] = true,
    [Enum.KeyCode.X] = true,
    [Enum.KeyCode.C] = true,
    [Enum.KeyCode.V] = true,
    [Enum.KeyCode.F] = true
}

table.insert(State.Connections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if SkillKeyMap[input.KeyCode] then
        TriggerSkillAimWindow(0.85)
    end

    if gameProcessed then return end

    if input.KeyCode == Config.Key_ToggleUI then
        ToggleMainWindowVisibility()
    elseif input.KeyCode == Config.Key_CameraLock then
        Config.CameraLock = not Config.CameraLock
        if CamLockToggleRef then
            CamLockToggleRef.Set(Config.CameraLock, false)
        end
        if Config.CameraLock then
            State.LockedTarget = GetBestTarget()
            if State.LockedTarget then
                TagPlayerInCombatWithMe(State.LockedTarget, 65)
            end
            CamLockStroke.Color = Theme.HudRedText
            CamLockStroke.Transparency = 0
            CamLockBtn.TextColor3 = Color3.fromRGB(255, 215, 55)
        else
            State.LockedTarget = nil
            CamLockStroke.Color = Color3.fromRGB(52, 55, 64)
            CamLockStroke.Transparency = 0.25
            CamLockBtn.TextColor3 = Theme.HudRedText
        end
    elseif input.KeyCode == Config.Key_TPToTarget then
        local target = State.LockedTarget or State.CurrentTarget or GetBestTarget()
        if target and IsPlayerAlive(target) then
            local myHrp = GetRootPart(LocalPlayer)
            local tHrp  = GetRootPart(target)
            if myHrp and tHrp then
                TagPlayerInCombatWithMe(target, 65)
                TryPortalBypass(tHrp.Position)
                myHrp.CFrame = tHrp.CFrame * CFrame.new(0, Config.TeleportOffsetY, Config.TeleportOffsetZ)
            end
        end
    elseif input.KeyCode == Config.Key_SkipTarget then
        local cur = State.LockedTarget or State.CurrentTarget
        if cur then
            State.BlacklistedTargets[cur.UserId] = true
            State.CombatTaggedPlayers[cur.UserId] = nil
            State.InCombatWithMe[cur.UserId] = nil
            State.LockedTarget = nil
            State.CurrentTarget = nil
            Notify("Target Skipped", "Blacklisted " .. cur.Name, 2)
        end
    elseif input.KeyCode == Config.Key_SoruSilent and Config.SoruSilent then
        local target = State.LockedTarget or State.CurrentTarget
        if target and IsPlayerAlive(target) then
            local myHrp = GetRootPart(LocalPlayer)
            local tHrp  = GetRootPart(target)
            if myHrp and tHrp and (myHrp.Position - tHrp.Position).Magnitude <= Config.SoruSilentRange then
                TagPlayerInCombatWithMe(target, 65)
                myHrp.CFrame = tHrp.CFrame * CFrame.new(0, 0, 3.5)
            end
        end
    end
end))

table.insert(State.Connections, UserInputService.InputEnded:Connect(function(input)
    if SkillKeyMap[input.KeyCode] then
        TriggerSkillAimWindow(0.65)
    end
end))

